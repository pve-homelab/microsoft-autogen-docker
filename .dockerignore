# Node / build artifacts
frontend/node_modules/
frontend/dist/

# Python caches
**/__pycache__/
**/*.pyc

# Local output should not be baked into the image
backend/output/
output/

# Vendored autogen: exclude git history + non-python parts to shrink context.
vendor/autogen/.git/
vendor/autogen/dotnet/
vendor/autogen/docs/
vendor/autogen/**/node_modules/

# Misc
.git/
*.log
