# Model endpoint (OpenAI-compatible /v1). Used by all agents.
MODEL_BASE_URL=http://host.docker.internal:8000/v1
MODEL_API_KEY=none
MODEL_NAME=local-model

# Where generated files are written inside the container (mount this volume).
OUTPUT_DIR=/app/output

# Where the built frontend is served from inside the container.
STATIC_DIR=/app/static
